{
  "expo": {
    "name": "The Off Grid",
    "slug": "the-off-grid",
    "version": "4.0.0",
    "orientation": "portrait",
    "scheme": "theoffgrid",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.theoffgrid.app"
    },
    "android": {
      "package": "in.theoffgrid.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "theoffgrid.in",
              "pathPrefix": "/product"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 3
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A0A0A"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Off Grid to access your photos so you can add them to a product review."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow The Off Grid to use your microphone for voice product search.",
          "speechRecognitionPermission": "Allow The Off Grid to convert your spoken product search into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b2cc9c2-a726-460d-b01d-9d246975d160"
      }
    },
    "owner": "kiranmamadapur",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
